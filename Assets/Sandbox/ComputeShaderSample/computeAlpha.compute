// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel ComputeAlpha
#pragma kernel ExpandTextureResult

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float> ShrinkBuffer;
Texture2D<float4> Texture;

int pixelPerDivW;
int pixelPerDivH;
int divCount;

[numthreads(1,1,1)]
void ComputeAlpha (uint3 id : SV_DispatchThreadID)
{
    float result = 0;
    uint halfWidthPixelPerDiv = (uint)pixelPerDivW / 2u;
    uint halfHeightPixelPerDiv = (uint)pixelPerDivH / 2u;

    for (int i = -(int)halfHeightPixelPerDiv; i <= (int)halfHeightPixelPerDiv; i++)
    {
        for (int j = -(int)halfWidthPixelPerDiv; j <= (int)halfWidthPixelPerDiv; j++)
        {
            uint u = (id.x * pixelPerDivW) + halfWidthPixelPerDiv + j;
            uint v = (id.y * pixelPerDivH) + halfHeightPixelPerDiv + i;
            float4 tex = Texture[uint2(u, v)];
            result += tex.a;
        }
    }
    
    float denom = 1. / (pixelPerDivW * pixelPerDivH);
    ShrinkBuffer[uint2(id.x, id.y)] = result * denom;
}

RWTexture2D<float4> ResultTexture;

[numthreads(1,1,1)]
void ExpandTextureResult(uint3 id : SV_DispatchThreadID)
{
    uint indexX = id.x / pixelPerDivW;
    uint indexY = id.y / pixelPerDivH;
    ResultTexture[uint2(id.x, id.y)] = ShrinkBuffer[uint2(indexX, indexY)];
}
